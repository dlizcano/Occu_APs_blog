geom_hline(yintercept = 1, linetype = "solid", color = "gray40") +
coord_flip() +
labs(title = "Yasuni Impact",
x = "Variable",
y = "Effect (Delta inside-outside)") +
theme_minimal() + theme(panel.grid.minor = element_line(colour = "white"))
# Graficar (excluye el intercepto para mayor claridad)
yasuni_table %>%
# filter(term != "(Intercept)") %>% # deja fuera
# mutate(term = gsub("Habitat", "", term)) %>%  # Opcional: limpiar nombres
ggplot(aes(x = reorder(term, estimate), y = estimate)) +
geom_point(color = "blue", size = 3) +
geom_text(aes(label = estimate), vjust = -1.5, nudge_y = 0) +
geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.1, color = "blue") +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray40") +
geom_hline(yintercept = -1, linetype = "solid", color = "gray40") +
geom_hline(yintercept = 1, linetype = "solid", color = "gray40") +
coord_flip() +
labs(title = "Yasuni Impact",
x = "Variable",
y = "Effect (Delta inside-outside)") +
theme_minimal() + theme(panel.grid.minor = element_line(colour = "white"))
